# Token2OAuth server
TOKEN2OAUTH_PORT=2030
TOKEN2OAUTH_HOST=127.0.0.1
TOKEN2OAUTH_PUBLIC_BASE_URL=https://your-node.your-tailnet.ts.net/token2oauth
TOKEN2OAUTH_BASE_PATH=/token2oauth

# Optional overrides
# TOKEN2OAUTH_CONFIG_DIR=~/.config/token2oauth
